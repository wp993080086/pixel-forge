# 统一换行符：仓库内一律使用 LF，检出时不转换（Windows 也保持 LF）
* text=auto eol=lf

# 明确文本类型，避免被误判为二进制
*.dart   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.xml    text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.ts     text eol=lf
*.sh     text eol=lf
*.gradle text eol=lf
*.kts    text eol=lf
*.cmake  text eol=lf

# 二进制文件不做换行符转换
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
*.jar    binary
*.keystore binary
*.so     binary
*.dll    binary
*.exe    binary

# Windows 批处理脚本必须保留 CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf
